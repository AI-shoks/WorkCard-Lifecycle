# Только синтетическое локальное окружение. Не используйте реальные учётные данные.
WORKCARD_ENVIRONMENT=local
WORKCARD_LOG_LEVEL=INFO
WORKCARD_DATABASE_URL=postgresql://workcard_app:REPLACE_WITH_LOCAL_PASSWORD@db:5432/workcard
WORKCARD_MIGRATION_DATABASE_URL=postgresql://workcard_migrator:REPLACE_WITH_LOCAL_PASSWORD@db:5432/workcard
# Только для bootstrap/privilege assertions в отдельном integration cluster, не для API.
WORKCARD_TEST_DATABASE_URL=postgresql://workcard_admin:REPLACE_WITH_LOCAL_PASSWORD@db:5432/workcard
WORKCARD_SESSION_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WORKCARD_ALLOWED_ORIGINS=["http://localhost:8000"]
WORKCARD_COOKIE_SECURE=false

# Используются только docker compose и bootstrap-скриптом PostgreSQL.
WORKCARD_POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
WORKCARD_APP_DATABASE_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
