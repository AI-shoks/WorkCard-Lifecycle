# Только безопасные local demo-значения. Не используйте их в hosted environment.
APP_ENV=development
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
PROXY_TRUST_MODE=none
APP_ORIGIN=http://localhost:5173
COMPOSE_APP_ORIGIN=http://localhost:3000
SESSION_SIGNING_SECRET=local-development-session-secret-change-me
POSTGRES_PORT=55439
POSTGRES_DB=workcard
POSTGRES_USER=workcard_owner
POSTGRES_PASSWORD=workcard_owner_local
APP_DATABASE_USER=workcard_app
APP_DATABASE_PASSWORD=workcard_app_local
MIGRATION_DATABASE_URL=postgresql://workcard_owner:workcard_owner_local@localhost:55439/workcard
DATABASE_URL=postgresql://workcard_app:workcard_app_local@localhost:55439/workcard
DEMO_MAX_BATCHES=20
DEMO_MAX_SESSIONS=500
