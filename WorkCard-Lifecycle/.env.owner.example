# Synthetic local owner configuration only. Supply explicitly to owner tasks.
# Never load this file into the API or browser process.
APP_ENV=test
MIGRATION_DATABASE_URL=postgresql://workcard_owner:workcard_owner_local@localhost:55439/workcard
# Only bootstrap/release/migrate need these role provisioning values.
APP_DATABASE_USER=workcard_app
APP_DATABASE_PASSWORD=workcard_app_local
# Hosted tasks additionally require NEON_DATABASE_HOST and NEON_DATABASE_NAME.
